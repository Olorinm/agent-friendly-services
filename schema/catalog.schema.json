{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Olorinm/agent-friendly-services/main/schema/catalog.schema.json",
  "title": "Candidate discovery and documented access routes v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)?$"
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "checked_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "official_docs",
              "official_repo",
              "official_announcement",
              "official_site",
              "publisher_listing"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "checked_on",
          "kind"
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/route"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "classifications",
    "sources",
    "routes"
  ],
  "definitions": {
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "self_serve",
            "application",
            "invite_only",
            "paused",
            "retired",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    },
    "personal_access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "documented",
            "restricted",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "const": "restricted"
              }
            }
          },
          "then": {
            "required": [
              "notes"
            ]
          }
        }
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "none",
            "api_key",
            "oauth",
            "platform_credentials",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    },
    "data_kind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "live",
            "cached",
            "sandbox",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "documented",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "const": "unsupported"
              }
            }
          },
          "then": {
            "required": [
              "notes"
            ]
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "required",
            "not_required",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "interface": {
          "enum": [
            "api",
            "sdk",
            "cli",
            "mcp",
            "web",
            "mobile"
          ]
        },
        "maintainer": {
          "enum": [
            "official",
            "third_party",
            "unknown"
          ]
        },
        "entry_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "docs": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "via": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "$ref": "#/definitions/availability"
        },
        "personal_access": {
          "$ref": "#/definitions/personal_access"
        },
        "auth": {
          "$ref": "#/definitions/auth"
        },
        "data_kind": {
          "$ref": "#/definitions/data_kind"
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/capability"
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "company": {
              "$ref": "#/definitions/requirement"
            },
            "store": {
              "$ref": "#/definitions/requirement"
            },
            "website": {
              "$ref": "#/definitions/requirement"
            },
            "traffic": {
              "$ref": "#/definitions/requirement"
            },
            "industry_license": {
              "$ref": "#/definitions/requirement"
            },
            "contract": {
              "$ref": "#/definitions/requirement"
            },
            "invitation": {
              "$ref": "#/definitions/requirement"
            },
            "approval": {
              "$ref": "#/definitions/requirement"
            },
            "email_verification": {
              "$ref": "#/definitions/requirement"
            },
            "phone_verification": {
              "$ref": "#/definitions/requirement"
            },
            "identity_verification": {
              "$ref": "#/definitions/requirement"
            },
            "payment_method": {
              "$ref": "#/definitions/requirement"
            },
            "prepayment": {
              "$ref": "#/definitions/requirement"
            },
            "platform_account": {
              "$ref": "#/definitions/requirement"
            }
          },
          "required": []
        },
        "human_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "enum": [
                  "signup",
                  "credentials",
                  "activation",
                  "task"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "step",
              "stage",
              "evidence"
            ]
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "free_allowance",
                  "usage",
                  "minimum_spend"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "per": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "kind",
              "amount",
              "unit",
              "per",
              "scope",
              "evidence"
            ]
          }
        }
      },
      "required": [
        "id",
        "interface",
        "maintainer",
        "entry_url",
        "evidence"
      ]
    }
  }
}
